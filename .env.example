# Clank — environment. Copy to .env (gitignored) and fill in. Nothing here is
# committed; all real secrets and deploy identifiers stay local.

# ── Core ──
AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-1
OPENROUTER_API_KEY=sk-or-v1-...        # reasoning + image + embeddings

# ── Slack (the original single-tenant instance) ──
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=xoxb-...
DYNAMODB_TABLE_NAME=clank-mind-dev      # rename for your deploy

# ── Discord (multi-tenant, paid credits) ──
DISCORD_APP_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_OPENROUTER_API_KEY=             # separate billing account (falls back to OPENROUTER_API_KEY)
PROD_DYNAMODB_TABLE_NAME=clank-mind-prod
PROD_VECTOR_BUCKET=clank-memory-vectors-prod
PROD_VECTOR_INDEX=clank-memory
# Metering dials (defaults shown; all optional)
DISCORD_TRIAL_CREDITS=1
DISCORD_FREE_PER_DAY=0
DISCORD_SERVER_FREE_PER_DAY=0
DISCORD_COOLDOWN_SEC=15

# ── iMessage (HTTP Function URL) ──
IMESSAGE_TOKEN_SECRET=                  # openssl rand -hex 32 (HS256 session+draft JWTs)
IMESSAGE_BUNDLE_IDS=your.app,your.app.MessagesExt   # SIWA audience allowlist
IMESSAGE_DEV_AUTH=0                       # simulator dev auth opt-in — NEVER set in a launched deployment
IMESSAGE_DEV_KEY=                       # the dev-auth shared key (only used when IMESSAGE_DEV_AUTH=1)
IMESSAGE_COOLDOWN_SEC=8

# ── Deploy identifiers (custom domain + shared ACM cert + sharp layer) ──
API_BASE_DOMAIN=example.com             # bot serves api.<this>
ACM_CERT_ARN=arn:aws:acm:us-east-1:ACCOUNT:certificate/...
SHARP_LAYER_ARN=arn:aws:lambda:us-east-1:ACCOUNT:layer:sharp:2

# ── Optional ──
PRINTIFY_API_KEY=                       # t-shirt/merch subsystem (Slack only)
ALERT_EMAIL=you@example.com             # CloudWatch alarm notifications
VECTOR_DUAL_WRITE=true                  # kill switch for history→vector mirroring
# VLLM_IMAGE_URL / VLLM_API_KEY         # optional self-hosted image backend
