{
  "name": "clank",
  "version": "1.0.0",
  "description": "Multi-platform, multi-tenant image-generation bot with an evolving per-community mind — Slack + Discord on AWS Lambda (SST), DynamoDB + S3 Vectors memory, OpenRouter models",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "sst dev",
    "deploy": "sst deploy",
    "deploy:dev": "sst deploy --stage dev",
    "deploy:site": "sst deploy --stage site",
    "remove": "sst remove",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "keywords": [
    "slack",
    "discord",
    "image-generation",
    "llm",
    "openrouter",
    "serverless",
    "sst"
  ],
  "author": "Mike Dunn",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MikeyDunn/clank.git"
  },
  "homepage": "https://clank.fyi",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1106.0",
    "@aws-sdk/client-lambda": "^3.1106.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/client-s3vectors": "^3.1106.0",
    "@aws-sdk/lib-dynamodb": "^3.1106.0",
    "@discordjs/rest": "^2.6.3",
    "@slack/web-api": "^8.0.0",
    "discord-interactions": "^4.4.0",
    "electrodb": "^3.9.1",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.1106.0",
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^26.2.0",
    "sst": "^4.17.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
